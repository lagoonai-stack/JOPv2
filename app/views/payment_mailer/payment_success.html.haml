!!!
%html
  %body{ style: "margin:0; padding:0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background-color:#f5f5f5;" }
    %table{ width: "100%", cellpadding: "0", cellspacing: "0", style: "padding:40px 0;" }
      %tr
        %td{ align: "center" }
          %table{ width: "560", cellpadding: "0", cellspacing: "0", style: "background:#ffffff; border-radius:12px; padding:40px;" }
            %tr
              %td{ style: "text-align:center; padding-bottom:30px;" }
                %h1{ style: "margin:0; font-size:24px; font-weight:600;" }= t(".title")
                %p{ style: "margin-top:10px; color:#666;" }= t(".subtitle")
            %tr
              %td{ style: "padding-bottom:20px; font-size:16px;" }
                = t(".greeting", name: @user.username)
            %tr
              %td
                %table{ width: "100%", cellpadding: "0", cellspacing: "0", style: "border:1px solid #eaeaea; border-radius:10px; padding:24px;" }
                  %tr
                    %td{ style: "font-size:18px; font-weight:600; padding-bottom:15px;" }= @plan[:name]
                    %td{ align: "right", style: "font-size:18px; font-weight:600;" }
                      = number_to_currency(@plan[:price_cents] / 100.0, unit: "R$", separator: I18n.t("number.currency.format.separator"), delimiter: I18n.t("number.currency.format.delimiter"))
                      %span{ style: "font-size:14px; color:#666;" }= " / #{t('.per_month')}"
                  %tr
                    %td{ colspan: "2", style: "padding-top:15px; font-size:14px; color:#555;" }
                      • #{t(".tokens", count: @plan[:max_tokens_per_month])}
                      %br
                      • #{t(".videos_description")}
                      %br
                      • #{t(".access_chat")}
                  %tr
                    %td{ colspan: "2", style: "padding-top:20px; font-size:14px;" }
                      %strong= "#{t('.status')}:"
                      %span{ style: "color:#0a7f42;" }= t(".active")
            %tr
              %td{ align: "center", style: "padding-top:30px;" }
                = link_to t(".cta"), chat_url, style: "display:inline-block; padding:14px 28px; background:#111; color:#fff; text-decoration:none; border-radius:8px; font-weight:500;"
            %tr
              %td{ style: "padding-top:30px; font-size:13px; color:#888; text-align:center;" }
                = t(".footer")
